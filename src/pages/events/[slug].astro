---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isPublished } from '../../lib/published';

export async function getStaticPaths() {
  const events = (await getCollection('events')).filter((e) => isPublished(e));
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'events'> };
const { Content } = await render(entry);
---
<Base title={entry.data.title}>
  <article>
    <h1>{entry.data.title}</h1>
    <p>
      <time>{formatDate(entry.data.startDate)}</time>
      {entry.data.endDate && <> 〜 <time>{formatDate(entry.data.endDate)}</time></>}
      {entry.data.venue && <> / {entry.data.venue}</>}
    </p>
    {entry.data.image && <img src={entry.data.image} alt="" style="max-width:100%" />}
    <Content />
    {entry.data.applyUrl && <p><a class="btn" href={entry.data.applyUrl}>申し込む</a></p>}
  </article>
</Base>
