# 管理画面とPRのプレビュー。config/cms.env にコピーして使う。キーの説明はコアのREADMEの「配信基盤の契約」を参照。
# Terraformを使う場合は、terraform-apply.ymlが env-dir 入力で更新する。使わない場合は手で書く。
AWS_REGION=ap-northeast-1
S3_BUCKET=example-site
SITE_URL=https://cms.example.com
DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/example-cms-deploy
CLOUDFRONT_DISTRIBUTION_ID=E1234567890XYZ
