# 配信先の情報。config/deploy.env にコピーして使う。キーの説明はコアのREADMEの「配信基盤の契約」を参照。
# Terraformを使う場合は、terraform-apply.ymlが env-file 入力で更新する。使わない場合は手で書く。
AWS_REGION=ap-northeast-1
S3_BUCKET=example-site
CMS_DOMAIN=cms.example.com
CMS_ADMIN_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/example-cms-admin-deploy
CMS_PREVIEW_ROLE_ARN=arn:aws:iam::123456789012:role/example-cms-preview-publisher
STAGING_SITE_URL=https://staging.example.com
STAGING_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/example-staging-deploy
STAGING_CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
PRODUCTION_SITE_URL=https://example.com
PRODUCTION_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/example-production-deploy
PRODUCTION_CLOUDFRONT_DISTRIBUTION_ID=E1234567890DEF
TERRAFORM_PLAN_ROLE_ARN=arn:aws:iam::123456789012:role/example-terraform-plan
TERRAFORM_APPLY_ROLE_ARN=arn:aws:iam::123456789012:role/example-terraform-apply
TERRAFORM_STATE_BUCKET=example-site
