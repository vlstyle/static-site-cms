---
import { withBase } from 'static-site-cms/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isPublished } from 'static-site-cms/published';

const news = (await getCollection('news'))
  .filter((n) => isPublished(n))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="お知らせ">
  <h1>お知らせ</h1>
  <ul>{news.map((n) => <li>{formatDate(n.data.date)} <a href={withBase(`/news/${n.id}/`)}>{n.data.title}</a></li>)}</ul>
</Base>
