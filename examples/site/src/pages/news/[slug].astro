---
import { withBase, withBaseInHtml } from 'static-site-cms/url';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isPublished } from 'static-site-cms/published';

export async function getStaticPaths() {
  const news = (await getCollection('news')).filter((n) => isPublished(n));
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'news'> };
const html = withBaseInHtml(entry.rendered?.html ?? '');
---
<Base title={entry.data.title}>
  <article>
    <h1>{entry.data.title}</h1>
    <time>{formatDate(entry.data.date)}</time>
    {entry.data.image && <img src={withBase(entry.data.image)} alt="" style="max-width:100%" />}
    <Fragment set:html={html} />
  </article>
</Base>
