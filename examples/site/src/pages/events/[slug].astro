---
import { withBase, withBaseInHtml } from 'static-site-cms/url';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isPublished } from 'static-site-cms/published';

export async function getStaticPaths() {
  const events = (await getCollection('events')).filter((e) => isPublished(e));
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'events'> };
const html = withBaseInHtml(entry.rendered?.html ?? '');
---
<Base title={entry.data.title}>
  <article>
    <h1>{entry.data.title}</h1>
    <p>
      <time>{formatDate(entry.data.startDate)}</time>
      {entry.data.endDate && <> 〜 <time>{formatDate(entry.data.endDate)}</time></>}
      {entry.data.venue && <> / {entry.data.venue}</>}
    </p>
    {entry.data.image && <img src={withBase(entry.data.image)} alt="" style="max-width:100%" />}
    <Fragment set:html={html} />
    {entry.data.applyUrl && <p><a class="btn" href={withBase(entry.data.applyUrl)}>申し込む</a></p>}
  </article>
</Base>
