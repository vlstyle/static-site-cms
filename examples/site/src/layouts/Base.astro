---
interface Props {
  title: string;
  description?: string;
}
import { isPreview } from 'static-site-cms/published';

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <style is:global>
      :root { --accent: #0b5fff; --fg: #1a1a1a; --muted: #5c6370; --bg: #fff; --soft: #f4f6fa; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, "Hiragino Sans", "Noto Sans JP", sans-serif; color: var(--fg); background: var(--bg); line-height: 1.7; }
      a { color: var(--accent); }
      header.site, main, footer { padding-inline: 16px; }
      header.site { display: flex; gap: 16px; align-items: center; max-width: 960px; margin: 0 auto; padding-block: 12px; }
      header.site a { text-decoration: none; font-weight: 600; }
      main { max-width: 960px; margin: 0 auto; }
      footer { max-width: 960px; margin: 48px auto 24px; color: var(--muted); font-size: 0.9rem; }
      .btn { display: inline-block; padding: 12px 24px; background: var(--accent); color: #fff; border-radius: 6px; text-decoration: none; font-weight: 600; }
    </style>
  </head>
  <body>
    <header class="site">
      <a href="/">Home</a>
      <a href="/news/">お知らせ</a>
      <a href="/events/">イベント</a>
    </header>
    <main><slot /></main>
    <footer>© Static Site CMS PoC</footer>
  </body>
</html>
