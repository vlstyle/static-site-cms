const crypto = require('crypto');

%{ if length(allowed_cidrs) > 0 ~}
function toInt(ip) {
  var p = ip.split('.');
  return (((+p[0]) * 256 + (+p[1])) * 256 + (+p[2])) * 256 + (+p[3]);
}

function inCidr(ip, cidr) {
  var parts = cidr.split('/');
  var size = Math.pow(2, 32 - (+parts[1]));
  var base = Math.floor(toInt(parts[0]) / size) * size;
  var value = toInt(ip);
  return value >= base && value < base + size;
}

var allowedCidrs = ${jsonencode(allowed_cidrs)};

%{ endif ~}
%{ if basic_auth_hash != "" ~}
var salt = '${salt}';
var expected = '${basic_auth_hash}';

function authorized(header) {
  if (!header || header.indexOf('Basic ') !== 0) return false;
  var token = header.slice(6);
  return crypto.createHash('sha256').update(salt + token).digest('hex') === expected;
}

%{ endif ~}
function redirect(location) {
  return { statusCode: 301, statusDescription: 'Moved Permanently', headers: { location: { value: location } } };
}

function handler(event) {
  var request = event.request;
%{ if length(allowed_cidrs) > 0 ~}

  var ip = event.viewer.ip;
  var allowed = ip.indexOf(':') === -1 && allowedCidrs.some(function (cidr) { return inCidr(ip, cidr); });
  if (!allowed) {
    return { statusCode: 403, statusDescription: 'Forbidden' };
  }
%{ endif ~}
%{ if basic_auth_hash != "" ~}

  var authorization = request.headers.authorization;
  if (!authorization || !authorized(authorization.value)) {
    return {
      statusCode: 401,
      statusDescription: 'Unauthorized',
      headers: { 'www-authenticate': { value: 'Basic realm="cms"' } }
    };
  }
%{ endif ~}

  var uri = request.uri;
  if (uri === '/') {
    return redirect('/admin/');
  }

  var match = uri.match(/^\/(admin|preview\/pr-[0-9]+)(\/.*)?$/);
  if (!match) {
    return { statusCode: 404, statusDescription: 'Not Found' };
  }

  var rest = match[2];
  if (!rest) {
    return redirect(uri + '/');
  }
  if (rest.endsWith('/')) {
    request.uri = uri + 'index.html';
  } else if (rest.indexOf('.', rest.lastIndexOf('/')) === -1) {
    return redirect(uri + '/');
  }
  return request;
}
