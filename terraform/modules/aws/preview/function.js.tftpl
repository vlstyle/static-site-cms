function handler(event) {
  var request = event.request;
  var headers = request.headers;

  if (!headers.authorization || headers.authorization.value !== 'Basic ${basic_auth}') {
    return {
      statusCode: 401,
      statusDescription: 'Unauthorized',
      headers: { 'www-authenticate': { value: 'Basic realm="preview"' } }
    };
  }

  var match = headers.host.value.match(/^(pr-[0-9]+)\.${domain_regex}$/);
  if (!match) {
    return { statusCode: 404, statusDescription: 'Not Found' };
  }

  var uri = request.uri;
  if (uri.endsWith('/')) {
    uri += 'index.html';
  } else if (uri.indexOf('.', uri.lastIndexOf('/')) === -1) {
    uri += '/index.html';
  }
  request.uri = '/' + match[1] + uri;
  return request;
}
